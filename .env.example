# Accesso browser con account locali, creati dal terminale del server.
# true soltanto dietro HTTPS; false per la LAN HTTP fidata.
JENNY_COOKIE_SECURE=false
# Solo per il worker opzionale: segreto casuale di almeno 24 caratteri.
# Non è una password utente e non permette l'accesso browser.
JENNY_WORKER_TOKEN=
JENNY_BIND=127.0.0.1
JENNY_PORT=3000
# ollama = API nativa ottimizzata; openai = LocalAI e altri server /v1.
LLM_PROVIDER=ollama
# Con ollama sono accettati sia l'host puro sia il suffisso /v1.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=
LLM_API_KEY=
LLM_STREAMING=true
# Include il caricamento iniziale del modello.
LLM_TIMEOUT_MS=300000
# Valori iniziali, da calibrare sul modello e sulla VRAM disponibile.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m
# auto omette il parametro; false/true/low/medium/high dipendono dal modello.
OLLAMA_THINK=auto

# Ricerca web: searxng, brave, duckduckgo oppure auto (compatibilità 0.6).
WEB_SEARCH_PROVIDER=searxng
# Indirizzo previsto sul server di casa: verificarne la raggiungibilità dal container.
SEARXNG_BASE_URL=http://192.168.10.250:8081
# Consente solo la richiesta di ricerca al server SearXNG configurato, non gli URL web.
SEARXNG_ALLOW_PRIVATE=true
# Alternativa facoltativa, usata solo con brave/auto. Mai pubblicare chiavi reali.
BRAVE_SEARCH_API_KEY=
