# ./start-web.sh genera automaticamente il token se .env non esiste.
JENNY_TOKEN=
JENNY_BIND=127.0.0.1
JENNY_PORT=3000
# ollama = API nativa ottimizzata; openai = LocalAI e altri server /v1.
LLM_PROVIDER=ollama
# Con ollama sono accettati sia l'host puro sia il suffisso /v1.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=
LLM_API_KEY=
LLM_STREAMING=true
# Include il caricamento iniziale del modello.
LLM_TIMEOUT_MS=300000
# Valori iniziali, da calibrare sul modello e sulla VRAM disponibile.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m
# auto omette il parametro; false/true/low/medium/high dipendono dal modello.
OLLAMA_THINK=auto
